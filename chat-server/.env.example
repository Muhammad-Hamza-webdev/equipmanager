# chat-server/.env.example
# Copy this to .env and fill in real values.
# .env is gitignored — never commit it.

PORT=3000
PHP_API_URL=http://localhost/equipmanager

# Must match JWT_SECRET in phpenv.php
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING

# Must match NODE_API_SECRET in phpenv.php
NODE_API_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING

CORS_ORIGIN=http://localhost
LOG_LEVEL=info
